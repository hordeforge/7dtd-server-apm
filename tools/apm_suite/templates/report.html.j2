<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Geiger report: {{ session.name }}</title><link rel="icon" href="{{ favicon }}">
<style>{{ css|safe }}</style></head><body><main class="page">
<header>{{ brand_mark|safe }}<h1>Session report</h1><p class="muted">{{ session.name }}{% if meta.utc %} · {{ meta.utc }}{% endif %}</p><nav><a href="dashboard.html">Dashboard</a> · <a href="../index.html">All sessions</a> · <a href="manifest.json">Manifest</a></nav></header>
<p>{{ summary.recommendation or 'No recommendation was produced for this session.' }}</p>
<div class="scroll"><table><caption class="sr-only">Layer scores</caption><tr><th scope="col">Layer</th><th scope="col" class="num">Score</th><th scope="col">Signals</th><th scope="col">Actions</th></tr>{% for layer in summary.layers %}<tr><td>{{ layer.layer }}</td><td class="num">{{ layer.score if layer.score is not none else (layer.state or 'no data') }}</td><td><pre>{{ layer.signals|tojson(indent=2) }}</pre></td><td><ul>{% for action in layer.optimize %}<li>{{ action }}</li>{% endfor %}</ul></td></tr>{% else %}<tr><td class="empty" colspan="4">No layers were scored in this session.</td></tr>{% endfor %}</table></div>
</main></body></html>
