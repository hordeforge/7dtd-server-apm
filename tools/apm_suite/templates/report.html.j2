<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>7dtd APM report: {{ session.name }}</title>
<style>/* Shared APM web tokens (report + dashboard + session index): bg #0f1115 · surface #161a22 · outline #2a2f3a · rule #303642 · text #e8eaed · muted #9aa0a6 · link #8ab4f8 · accent #e6bd3a */:root{color-scheme:dark}body{font:14px system-ui;max-width:1200px;margin:24px auto;background:#0f1115;color:#e8eaed}header{margin-bottom:16px}header h1{margin:0 0 4px}header p{margin:0 0 8px}table{width:100%;border-collapse:collapse}th,td{padding:8px;border:1px solid #303642;text-align:left;vertical-align:top}a{color:#8ab4f8}pre{white-space:pre-wrap;margin:0}.muted{color:#9aa0a6}.scroll{overflow-x:auto}td.empty{text-align:center;color:#9aa0a6}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;clip-path:inset(50%);overflow:hidden;white-space:nowrap}</style></head><body><main>
<header><h1>7dtd APM report</h1><p class="muted">{{ session.name }}{% if meta.utc %} · {{ meta.utc }}{% endif %}</p><nav><a href="dashboard.html">Open dashboard</a> · <a href="../index.html">All sessions</a> · <a href="manifest.json">Manifest</a></nav></header>
<p>{{ summary.recommendation or 'No recommendation was produced for this session.' }}</p>
<div class="scroll"><table><caption class="sr-only">Layer scores</caption><tr><th scope="col">Layer</th><th scope="col">Score</th><th scope="col">Signals</th><th scope="col">Actions</th></tr>{% for layer in summary.layers %}<tr><td>{{ layer.layer }}</td><td>{{ layer.score if layer.score is not none else (layer.state or 'no data') }}</td><td><pre>{{ layer.signals|tojson(indent=2) }}</pre></td><td><ul>{% for action in layer.optimize %}<li>{{ action }}</li>{% endfor %}</ul></td></tr>{% else %}<tr><td class="empty" colspan="4">No layers were scored in this session.</td></tr>{% endfor %}</table></div>
</main></body></html>
