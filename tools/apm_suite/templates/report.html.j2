<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>7dtd APM report — {{ session.name }}</title>
<style>:root{color-scheme:dark}body{font:14px system-ui;max-width:1200px;margin:24px auto;background:#0f1115;color:#e8eaed}table{width:100%;border-collapse:collapse}th,td{padding:8px;border:1px solid #333;text-align:left;vertical-align:top}a{color:#8ab4f8}pre{white-space:pre-wrap}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;clip-path:inset(50%);overflow:hidden;white-space:nowrap}</style></head><body>
<h1>7dtd APM report</h1><p>{{ summary.recommendation }}</p>
<table><caption class="sr-only">Layer scores</caption><tr><th scope="col">Layer</th><th scope="col">Score</th><th scope="col">Signals</th><th scope="col">Actions</th></tr>{% for layer in summary.layers %}<tr><td>{{ layer.layer }}</td><td>{{ layer.score if layer.score is not none else (layer.state or 'no data') }}</td><td><pre>{{ layer.signals|tojson(indent=2) }}</pre></td><td><ul>{% for action in layer.optimize %}<li>{{ action }}</li>{% endfor %}</ul></td></tr>{% endfor %}</table>
<p><a href="dashboard.html">Open dashboard</a> · <a href="../index.html">All sessions</a> · <a href="manifest.json">Manifest</a></p>
</body></html>
