<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>7dtd APM: {{ session.name }}</title>
<style>{{ css|safe }}</style></head><body>
<header><h1>7dtd APM Dashboard</h1><div class="muted">{{ session.name }}{% if meta.pid %} · pid {{ meta.pid }}{% endif %}{% if meta.utc %} · {{ meta.utc }}{% endif %}</div><nav><a href="report.html">Report</a> · <a href="../index.html">All sessions</a></nav></header>
<main>
<div class="tiles">
{% if lag.verdict %}<section class="tile"><h2>Lag diagnosis</h2><p class="verdict">{{ lag.verdict }}</p>{% if lag.profile %}<p class="muted">{{ lag.profile }}</p>{% endif %}{% for c in lag.causes %}<p>· <b>{{ c.cause }}</b> ({{ c.severity }}): {{ c.detail }}{% if c.fix %}<br><span class="muted">fix: {{ c.fix }}</span>{% endif %}</p>{% endfor %}</section>{% endif %}
<section class="tile"><h2>Health</h2>{% if health.grade or health.health %}<div class="grade">{{ health.grade or '?' }} <span class="muted">{{ health.health or '?' }}</span></div><p class="muted">pressure {{ health.pressure ~ '%' if health.pressure is number else '?' }}</p>{% else %}<p class="muted">No health score was produced for this session.</p>{% endif %}</section>
<section class="tile"><h2>Frame / GC</h2>
{% if frameinfo %}<p>tick avg <span class="mono">{{ frameinfo.tickIntervalAvgMs|round(1) if frameinfo.tickIntervalAvgMs is number else '?' }}</span> ms · gmUpdate <span class="mono">{{ frameinfo.gmUpdateAvgMs|round(1) if frameinfo.gmUpdateAvgMs is number else '?' }}</span> ms · late ticks <span class="mono">{{ frameinfo.lateTicks }}</span></p>{% endif %}
{% if gcinfo %}<p>GC: {% if gcinfo.grossAllocMBPerSecond is not none %}<span class="mono">{{ gcinfo.grossAllocMBPerSecond|round(1) if gcinfo.grossAllocMBPerSecond is number else '?' }}</span> MB/s gross churn · {% endif %}<span class="mono">{{ gcinfo.allocMBPerSecond|round(1) if gcinfo.allocMBPerSecond is number else '?' }}</span> MB/s net heap · <span class="mono">{{ gcinfo.fullCollections }}</span> full STW collections</p>
{% if churn_sites %}<p class="muted">steady churn: {{ churn_sites|join(', ') }}</p>{% endif %}
{% if alloc_sites %}<p class="muted">large-alloc spikes: {{ alloc_sites|join(', ') }}</p>{% endif %}{% endif %}
{% if transfers %}<p>chunk stream: <span class="mono">{{ transfers.mb_per_second|round(1) if transfers.mb_per_second is number else '?' }}</span> MB/s · <span class="mono">{{ transfers.packages_per_second|round(1) if transfers.packages_per_second is number else '?' }}</span> pkg/s</p>{% endif %}
{% if net %}<p>kernel udp (game): <span class="mono">{{ net.udp_send_mb_per_second|round(1) if net.udp_send_mb_per_second is number else '?' }}</span> MB/s send · <span class="mono">{{ net.udp_recv_mb_per_second|round(1) if net.udp_recv_mb_per_second is number else '?' }}</span> MB/s recv</p>{% endif %}
{% if worldinfo %}<p>world: <span class="mono">{{ worldinfo.entities }}</span> entities · <span class="mono">{{ worldinfo.players }}</span> players</p>{% endif %}{% if not (frameinfo or gcinfo or transfers or net or worldinfo) %}<p class="muted">No frame, GC, or network samples were collected for this session.</p>{% endif %}</section>
<section class="tile"><h2>Artifacts</h2><ul>{% for label, href in links %}<li><a href="{{ href }}">{{ label }}</a></li>{% else %}<li class="muted">None produced</li>{% endfor %}</ul></section>
</div>

<section class="block"><h2>Layer pressure</h2>{% for layer in layers %}<div class="layer"><span>{{ layer.layer }}</span>{% if layer.score is not none %}<div class="bar" aria-hidden="true"><div class="fill" style="width:{{ layer.score }}%"></div></div><span class="val">{{ layer.score }}</span>{% else %}<span class="bar" aria-hidden="true"></span><span class="val muted">{{ layer.state or 'no data' }}</span>{% endif %}</div>{% else %}<p class="muted">No layers were scored in this session.</p>{% endfor %}</section>
{% if attribution.subsystems %}<section class="block"><h2>Subsystem attribution (managed, window-scoped)</h2>
<p class="muted">measured <span class="mono">{{ attribution.measured_ms }}</span> ms{% if attribution.ms_per_tick %} · <span class="mono">{{ attribution.ms_per_tick }}</span> ms/tick{% endif %}{% if attribution.entities %} · <span class="mono">{{ attribution.entities }}</span> entities{% endif %}</p>
<div class="scroll"><table><caption class="sr-only">Subsystem attribution, managed and window-scoped</caption><tr><th scope="col">Subsystem</th><th scope="col" class="num">Scaled total ms</th><th scope="col" class="num">Share</th><th scope="col">Top sections</th></tr>
{% for s in attribution.subsystems %}<tr><td>{{ s.subsystem }}</td><td class="num">{{ s.scaled_total_ms }}</td><td class="num">{{ (s.share * 100)|round(1) if s.share is number else '?' }}%</td><td>{% for d in s.sections[:3] %}{{ d.name }} (<span class="mono">{{ d.scaled_total_ms }}</span>){% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endfor %}
</table></div></section>{% endif %}
<section class="block"><h2>Native → C# bridges</h2><div class="scroll"><table><caption class="sr-only">Native to C# bridge candidates</caption><tr><th scope="col">Title</th><th scope="col">Priority</th><th scope="col">Targets</th></tr>{% for bridge in bridges %}<tr><td>{{ bridge.title }}</td><td>{{ (bridge.inference or {}).priority or bridge.priority }}</td><td>{{ ((bridge.experiment or {}).harmony_targets or bridge.harmony_targets or [])|join(', ') }}</td></tr>{% else %}<tr><td class="empty" colspan="3">No bridge data</td></tr>{% endfor %}</table></div></section>
{% if stalls %}<section class="block"><h2>Worst frame stalls (± 2s correlated evidence)</h2>
<div class="scroll"><table><caption class="sr-only">Worst frame stalls with correlated evidence</caption><tr><th scope="col">gmUpdate ms</th><th scope="col">Detail</th><th scope="col">Nearby events</th></tr>
{% for s in stalls %}<tr><td class="num">{{ s.gm_update_ms }}</td><td><code>{{ s.message }}</code></td><td>{% for k, v in s.nearby_events.items() %}{{ k }}×{{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endfor %}
</table></div></section>{% endif %}
<section class="block"><h2>Events</h2><div class="scroll"><table><caption class="sr-only">Session events</caption><tr><th scope="col">Kind</th><th scope="col">Severity</th><th scope="col">Message</th></tr>{% for event in events %}<tr><td>{{ event.kind }}</td><td>{{ event.severity }}</td><td><code>{{ event.message }}</code></td></tr>{% else %}<tr><td class="empty" colspan="3">No events</td></tr>{% endfor %}</table></div></section>
</main></body></html>
