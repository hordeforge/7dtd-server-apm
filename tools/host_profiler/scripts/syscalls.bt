/* Syscall counts for TARGET_PID (thread) or TARGET_COMM. */
#ifndef TARGET_PID
#error "Define TARGET_PID"
#endif
#ifndef TARGET_COMM
#define TARGET_COMM "7DaysToDieServe"
#endif

tracepoint:raw_syscalls:sys_enter
/pid == TARGET_PID || comm == TARGET_COMM/
{
    @start[tid] = nsecs;
    @sysid[tid] = args.id;
}

tracepoint:raw_syscalls:sys_exit
/@start[tid]/
{
    $lat = (nsecs - @start[tid]) / 1000;
    $id = @sysid[tid];
    delete(@start[tid]);
    delete(@sysid[tid]);
    if (pid == TARGET_PID || comm == TARGET_COMM) {
        @count[$id] = count();
        @lat_us[$id] = hist($lat);
        @sum_us[$id] = sum($lat);
    }
}

END
{
    printf("\n=== syscall counts by id (pid=%d) ===\n", TARGET_PID);
    print(@count, 40);
    printf("\n=== total us by syscall id ===\n");
    print(@sum_us, 40);
    printf("\nDecode: ausyscall --dump | grep <id>  or  grep NR_ /usr/include/asm/unistd_64.h\n");
}
